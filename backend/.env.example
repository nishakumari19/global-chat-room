# MongoDB connection string (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/chat?retryWrites=true&w=majority)
MONGO_URI=your_mongodb_connection_string_here

# Backend server port
PORT=5000

# Client origin for CORS (e.g., your Vercel deployment URL or local Vite dev URL)
CLIENT_URL=your_frontend_url_here
