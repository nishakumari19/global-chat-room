# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
MONGO_URI=your_mongodb_connection_string_here

# Backend Server Port (default 5000 for standalone backend, 3000 for preview)
PORT=5000

# Client origin for CORS (e.g., your deployed Vercel frontend URL)
CLIENT_URL=your_frontend_url_here

# Frontend Socket.io & REST Backend URL (for Vercel deployment)
VITE_BACKEND_URL=your_backend_url_here


